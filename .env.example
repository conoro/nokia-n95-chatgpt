# Copy to .env and fill in your OpenAI API key and Responses model ID.
OPENAI_API_KEY=
OPENAI_MODEL=

# Choose a token and enter the same value in the phone's Settings.
BRIDGE_TOKEN=
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8095

# Change these to models and voices available to your API project.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_REASONING_EFFORT=low
